# =============================================================================
# Travel AI Assistant System - Environment Variables Configuration
# =============================================================================
# This file serves as a template for environment-specific configuration.
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Never commit the .env file to version control!
# The .env file should be added to .gitignore to protect sensitive data.
#
# Environment variables defined here will override values in config.yaml.
# Use the format: TRIP_ASSISTANT_SECTION__KEY=value
# Example: TRIP_ASSISTANT_DATABASE__PATH overrides database.path in config.yaml
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Configuration
# -----------------------------------------------------------------------------
# Specifies the deployment environment (development, testing, production)
# This affects logging verbosity and other environment-specific behaviors
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# LLM (Large Language Model) Configuration
# -----------------------------------------------------------------------------
# OpenAI API key for accessing GPT models
# Required for the AI assistant to function
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Alternative: Anthropic API key (if using Claude models)
# Uncomment if using Anthropic as the LLM provider
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM provider name (openai, anthropic, etc.)
# Override the provider specified in config.yaml
# TRIP_ASSISTANT_LLM__PROVIDER=openai

# Specific model identifier (e.g., gpt-4, gpt-3.5-turbo, claude-3-opus)
# Override the model specified in config.yaml
# TRIP_ASSISTANT_LLM__MODEL_NAME=gpt-4

# Sampling temperature for response generation (0.0-2.0)
# Lower values = more deterministic, higher values = more creative
# Override the temperature specified in config.yaml
# TRIP_ASSISTANT_LLM__TEMPERATURE=0.7

# Maximum number of tokens in generated responses
# Override the max_tokens specified in config.yaml
# TRIP_ASSISTANT_LLM__MAX_TOKENS=1000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Path to the SQLite database file
# Can be absolute or relative to the application root
# Override the database path specified in config.yaml
# TRIP_ASSISTANT_DATABASE__PATH=data/travel_new.sqlite

# Maximum number of database connections in the pool
# Higher values allow more concurrent operations but use more resources
# Override the pool_size specified in config.yaml
# TRIP_ASSISTANT_DATABASE__POOL_SIZE=5

# Connection timeout in seconds
# How long to wait for a database connection before timing out
# Override the timeout specified in config.yaml
# TRIP_ASSISTANT_DATABASE__TIMEOUT=30.0

# Number of retry attempts for failed database operations
# Transient errors will be retried this many times before failing
# Override the retry_attempts specified in config.yaml
# TRIP_ASSISTANT_DATABASE__RETRY_ATTEMPTS=3

# Exponential backoff multiplier for retries
# Delay between retries = backoff_factor ^ attempt_number
# Example: With factor 2.0, delays are 2s, 4s, 8s
# Override the retry_backoff_factor specified in config.yaml
# TRIP_ASSISTANT_DATABASE__RETRY_BACKOFF_FACTOR=2.0

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Whether caching is enabled (true/false)
# Caching improves performance by storing frequently accessed data in memory
# Override the cache enabled setting in config.yaml
# TRIP_ASSISTANT_CACHE__ENABLED=true

# Time-to-live for cached entries in seconds
# Cached data expires after this duration (300 = 5 minutes)
# Override the cache TTL specified in config.yaml
# TRIP_ASSISTANT_CACHE__TTL_SECONDS=300

# Maximum number of entries in the cache
# Oldest entries are evicted when this limit is reached
# Override the cache max_size specified in config.yaml
# TRIP_ASSISTANT_CACHE__MAX_SIZE=1000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Detailed diagnostic information (use in development)
# INFO: General informational messages (recommended for production)
# WARNING: Warning messages for potentially problematic situations
# ERROR: Error messages for operation failures
# CRITICAL: Critical errors that may cause system failure
LOG_LEVEL=INFO

# Override the logging level specified in config.yaml
# TRIP_ASSISTANT_LOGGING__LEVEL=INFO

# Log output format: json or text
# json: Structured JSON format (recommended for production/log aggregation)
# text: Human-readable text format (easier to read during development)
# Override the log format specified in config.yaml
# TRIP_ASSISTANT_LOGGING__FORMAT=json

# Path to the log file
# Logs will be written to this file with automatic rotation
# Override the log file path specified in config.yaml
# TRIP_ASSISTANT_LOGGING__FILE_PATH=logs/app.log

# Log file rotation size threshold
# A new log file is created when the current file reaches this size
# Supported units: KB, MB, GB (e.g., "10 MB", "1 GB")
# Override the log rotation setting in config.yaml
# TRIP_ASSISTANT_LOGGING__ROTATION=10 MB

# Number of rotated log files to retain
# Older log files are deleted when this limit is reached
# Override the log retention setting in config.yaml
# TRIP_ASSISTANT_LOGGING__RETENTION=20

# Whether to output logs to console in addition to file (true/false)
# Useful for development and debugging
# Override the console output setting in config.yaml
# TRIP_ASSISTANT_LOGGING__CONSOLE_OUTPUT=true

# -----------------------------------------------------------------------------
# Prompt Template Configuration
# -----------------------------------------------------------------------------
# Directory containing prompt templates
# Templates are organized by language (e.g., prompts/en/, prompts/zh/)
# Override the prompts directory specified in config.yaml
# TRIP_ASSISTANT_PROMPTS_DIR=prompts

# Default language code for prompts (e.g., en, zh)
# Used when no specific language is requested
# Override the default language specified in config.yaml
# TRIP_ASSISTANT_DEFAULT_LANGUAGE=en

# -----------------------------------------------------------------------------
# External Service Configuration (Optional)
# -----------------------------------------------------------------------------
# Tavily API key for web search functionality (if using Tavily)
# Get your API key from: https://tavily.com
# TAVILY_API_KEY=your-tavily-api-key-here

# LangSmith API key for tracing and debugging (optional)
# Get your API key from: https://smith.langchain.com
# LANGCHAIN_API_KEY=your-langsmith-api-key-here

# Enable LangSmith tracing (true/false)
# LANGCHAIN_TRACING_V2=false

# LangSmith project name for organizing traces
# LANGCHAIN_PROJECT=travel-assistant

# -----------------------------------------------------------------------------
# Monitoring and Metrics Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable performance metrics collection (true/false)
# ENABLE_METRICS=true

# Enable health check endpoint (true/false)
# ENABLE_HEALTH_CHECK=true

# Health check endpoint port
# HEALTH_CHECK_PORT=8000

# -----------------------------------------------------------------------------
# Security Configuration (Optional)
# -----------------------------------------------------------------------------
# Secret key for session management and encryption
# Generate a secure random string for production
# SECRET_KEY=your-secret-key-here

# Enable audit logging for sensitive operations (true/false)
# ENABLE_AUDIT_LOG=true

# -----------------------------------------------------------------------------
# Development and Testing Configuration
# -----------------------------------------------------------------------------
# Enable debug mode (true/false)
# Provides more verbose output and detailed error messages
# WARNING: Never enable in production!
# DEBUG=false

# Enable test mode (true/false)
# Uses test database and disables external API calls
# TEST_MODE=false

# Path to test database (used when TEST_MODE=true)
# TEST_DATABASE_PATH=tests/fixtures/test_database.sqlite

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. Environment Variable Override Format:
#    - Use double underscores (__) to represent nested configuration keys
#    - Example: TRIP_ASSISTANT_DATABASE__PATH overrides config.database.path
#    - Example: TRIP_ASSISTANT_LLM__API_KEY overrides config.llm.api_key
#
# 2. Variable Substitution in config.yaml:
#    - Use ${VAR_NAME} syntax in config.yaml to reference environment variables
#    - Example: api_key: "${OPENAI_API_KEY}" in config.yaml
#
# 3. Required Variables:
#    - OPENAI_API_KEY (or ANTHROPIC_API_KEY) is required for the system to function
#    - All other variables have defaults in config.yaml
#
# 4. Security Best Practices:
#    - Never commit .env file to version control
#    - Use strong, unique values for SECRET_KEY in production
#    - Rotate API keys regularly
#    - Use environment-specific .env files (.env.development, .env.production)
#
# 5. Multiple Environments:
#    - Create separate .env files for each environment
#    - Use .env.development for local development
#    - Use .env.testing for automated testing
#    - Use .env.production for production deployment
#    - Load the appropriate file based on the ENVIRONMENT variable
# =============================================================================
